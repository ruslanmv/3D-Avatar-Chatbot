# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-your-api-key-here

# Optional: Specify OpenAI model (defaults to gpt-3.5-turbo)
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
OPENAI_MODEL=gpt-3.5-turbo

# Application Configuration
APP_NAME=3D Avatar Chatbot
APP_VERSION=1.0.0

# VRoid Hub API (optional — pre-configures VRoid Hub for all users)
# When set, users just click "Authorize with VRoid Hub" without pasting keys.
# Get credentials at: https://hub.vroid.com/en/developers
VROID_APP_ID=
VROID_APP_SECRET=

# Image media providers (optional, additive)
# Pexels: real-photo search. A visitor can alternatively enter their own Pexels key in Settings.
# Get a free key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# Pollinations: AI image generation. Keep sk_ keys server-side only.
# Current Pollinations generation endpoints require authentication.
# Get a key at: https://enter.pollinations.ai/
POLLINATIONS_API_KEY=

# HomePilot Remote intentionally has no HOMEPILOT_* Vercel variable here.
# It reuses each user's existing OllaBridge pairing; HomePilot credentials stay behind OllaBridge.

# Note: This is just an example file.
# API keys are stored in browser localStorage for security.
# The deployment-owned image provider keys above are the exception: they stay server-side.
# Never commit actual API keys to version control!