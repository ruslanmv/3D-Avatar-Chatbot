# Vercel
.vercel

# Local development
.env.local
.env

# Development files
node_modules
npm-debug.log*
.DS_Store

# Testing
coverage
*.test.js
tests/

# Build artifacts
dist
/build

# Documentation (auto-generated, excluded from deployment)
docs/

# Git
.git
.github
.gitignore
.gitattributes

# Editor
.vscode
.idea
*.swp

# Backups
*.backup.*
index.backup.html

# CI/CD
.husky

# Documentation files
*.md
!README.md

# Configuration files not needed in production
.eslintrc.json
.prettierrc.json
.editorconfig
jsdoc.json
jest.config.js

# IMPORTANT: vendor folder and its contents MUST be deployed
# This includes Three.js libraries required for 3D rendering
!vendor/
!vendor/**/*

# IMPORTANT: the animation packs MUST be deployed too. Every motion command
# resolves to a file under addons/ (vrma-dance, vrma-actions), and a missing
# one is NOT a 404 — the catch-all rewrite in vercel.json serves index.html
# instead, so the loader receives "<!doctype html>" and every clip fails.
!addons/
!addons/**/*
!assets/
!assets/**/*
